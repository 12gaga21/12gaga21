API и интеграции

Kaspersky Security Network API

Проверка URL

```cpp
class KsnApiClient {
public:
    struct UrlCheckResult {
        bool isSafe;
        std::string threatType;
        std::string category;
        int reputationScore;
    };
    
    UrlCheckResult checkUrl(const std::string& url) {
        // Реализация вызова KSN API
        auto response = httpClient.post("https://ksn.kaspersky.com/api/urlcheck", {
            {"url", url},
            {"version", "1.0"}
        });
        
        return parseResponse(response);
    }
};
```

Локальная интеграция с антивирусом

Windows (через Named Pipes)

```cpp
class WindowsAvIntegration {
    bool scanFile(const std::wstring& filePath) {
        HANDLE pipe = CreateFile(L"\\\\.\\pipe\\KasperskyAntivirus",
                                GENERIC_READ | GENERIC_WRITE,
                                0, NULL, OPEN_EXISTING, 0, NULL);
        
        // Отправка команды сканирования
        ScanCommand cmd = {SCAN_FILE, filePath};
        DWORD written;
        WriteFile(pipe, &cmd, sizeof(cmd), &written, NULL);
        
        // Получение результата
        ScanResult result;
        DWORD read;
        ReadFile(pipe, &result, sizeof(result), &read, NULL);
        
        return result.isClean;
    }
};
```

