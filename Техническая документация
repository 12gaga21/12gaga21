```cpp
class DataEncryption {
private:
    QByteArray encryptionKey;
    
public:
    QByteArray encrypt(const QByteArray& data) {
        QByteArray iv(16, 0); // initialization vector
        return QAESEncryption::Crypt(QAESEncryption::AES_256, 
                                   QAESEncryption::CBC,
                                   data, encryptionKey, iv);
    }
    
    QByteArray decrypt(const QByteArray& encrypted) {
        QByteArray iv(16, 0);
        return QAESEncryption::Decrypt(QAESEncryption::AES_256,
                                     QAESEncryption::CBC,
                                     encrypted, encryptionKey, iv);
    }
};
```

