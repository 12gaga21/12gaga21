Менеджер базы данных

```cpp
class DatabaseManager {
private:
    QSqlDatabase db;
    
public:
    bool initialize() {
        db = QSqlDatabase::addDatabase("QSQLITE");
        db.setDatabaseName("kaspersky_shield.db");
        
        if (!db.open()) {
            qCritical() << "Cannot open database:" << db.lastError();
            return false;
        }
        
        return runMigrations();
    }
    
    void logSecurityEvent(const SecurityEvent& event) {
        QSqlQuery query;
        query.prepare("INSERT INTO security_events (type, severity, details) VALUES (?, ?, ?)");
        query.addBindValue(event.type);
        query.addBindValue(event.severity);
        query.addBindValue(event.details);
        query.exec();
    }
};
```

