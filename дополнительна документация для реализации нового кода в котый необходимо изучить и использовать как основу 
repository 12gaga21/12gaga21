        // Хельхейм - защита данных в состоянии покоя
        QByteArray crypt_data = data;
        
        // Ледяные стены Хельхейма - заморозка данных
        crypt_data = freezeInHelheimIce(crypt_data);
        
        // Страж Хель - защита от несанкционированного доступа
        crypt_data = guardByHel(crypt_data);
        
        // Река Гьёлль - шифрование потока
        crypt_data = crossGjollRiver(crypt_data);
        
        return crypt_data;
    }
    
    QByteArray applyMuspelheimProtection(const QByteArray& data) {
        // Муспельхейм - защита от огненных угроз (вирусы)
        QByteArray fire_protected_data = data;
        
        // Огненный меч Сурта - сжигание вирусов
        fire_protected_data = burnWithSurtursSword(fire_protected_data);
        
        // Стена огня - периметр защиты
        fire_protected_data = surroundWithFireWall(fire_protected_data);
        
        // Искры Муспелля - обнаружение угроз
        fire_protected_data = detectWithMuspelSparks(fire_protected_data);
        
        return fire_protected_data;
    }
