/* 
 * Kaspersky Home Shield Browser
 * Modern Dark Theme 2025
 * 
 * Дизайн: Минимализм + Glassmorphism + Темная тема
 */

/* ==================== ОСНОВНЫЕ ЦВЕТА ==================== */
* {
    /* Темная палитра 2025 */
    --bg-primary: #0F0F0F;
    --bg-secondary: #1A1A1A;
    --bg-tertiary: #242424;
    --bg-elevated: #2D2D2D;
    
    /* Акцентные цвета Kaspersky */
    --accent-primary: #00A88E;
    --accent-secondary: #00C9A7;
    --accent-hover: #00D4B3;
    
    /* Текст */
    --text-primary: #FFFFFF;
    --text-secondary: #B4B4B4;
    --text-tertiary: #6B6B6B;
    
    /* Границы */
    --border-color: #333333;
    --border-light: #404040;
    
    /* Состояния */
    --success: #00D98C;
    --warning: #FFB020;
    --danger: #FF4757;
    --info: #4E8FFF;
}

/* ==================== ГЛАВНОЕ ОКНО ==================== */
QMainWindow {
    background-color: #0F0F0F;
}

/* ==================== ЦЕНТРАЛЬНЫЙ ВИДЖЕТ ==================== */
QWidget {
    background-color: #0F0F0F;
    color: #FFFFFF;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Roboto", 
                 "Helvetica Neue", Arial, sans-serif;
    font-size: 14px;
}

/* ==================== МЕНЮ ==================== */
QMenuBar {
    background-color: #1A1A1A;
    border-bottom: 1px solid #333333;
    padding: 4px 8px;
    spacing: 8px;
}

QMenuBar::item {
    background: transparent;
    padding: 8px 16px;
    border-radius: 8px;
    color: #FFFFFF;
}

QMenuBar::item:selected {
    background-color: rgba(0, 168, 142, 0.15);
    color: #00D4B3;
}

QMenuBar::item:pressed {
    background-color: rgba(0, 168, 142, 0.25);
}

QMenu {
    background-color: #1A1A1A;
    border: 1px solid #333333;
    border-radius: 12px;
    padding: 8px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
}

QMenu::item {
    padding: 10px 24px 10px 16px;
    border-radius: 8px;
    margin: 2px 4px;
}

QMenu::item:selected {
    background-color: rgba(0, 168, 142, 0.15);
    color: #00D4B3;
}

QMenu::separator {
    height: 1px;
    background: #333333;
    margin: 8px 12px;
}

/* ==================== ТУЛБАР (СОВРЕМЕННЫЙ 2025) ==================== */
QToolBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #1A1A1A, stop:1 #151515);
    border: none;
    border-bottom: 1px solid #333333;
    spacing: 8px;
    padding: 8px 12px;
    min-height: 60px;
}

QToolBar::separator {
    background: #333333;
    width: 1px;
    margin: 8px 4px;
}

/* ==================== КНОПКИ (MODERN FLAT) ==================== */
QPushButton {
    background-color: #2D2D2D;
    color: #FFFFFF;
    border: 1px solid #404040;
    border-radius: 10px;
    padding: 10px 20px;
    font-weight: 500;
    font-size: 14px;
    min-height: 38px;
}

QPushButton:hover {
    background-color: #363636;
    border-color: #00A88E;
    box-shadow: 0 0 0 3px rgba(0, 168, 142, 0.1);
}

QPushButton:pressed {
    background-color: #242424;
    transform: scale(0.98);
}

QPushButton:disabled {
    background-color: #1A1A1A;
    color: #6B6B6B;
    border-color: #2D2D2D;
}

/* Акцентная кнопка */
QPushButton[primary="true"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #00A88E, stop:1 #00C9A7);
    border: none;
    color: #FFFFFF;
    font-weight: 600;
}

QPushButton[primary="true"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #00C9A7, stop:1 #00D4B3);
}

/* Кнопки тулбара */
QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 10px;
    padding: 10px;
    min-width: 40px;
    min-height: 40px;
    color: #FFFFFF;
}

QToolButton:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

QToolButton:pressed {
    background-color: rgba(255, 255, 255, 0.12);
}

QToolButton:checked {
    background-color: rgba(0, 168, 142, 0.2);
    color: #00D4B3;
}

/* ==================== АДРЕСНАЯ СТРОКА (ОМНИБОКС 2025) ==================== */
QLineEdit {
    background-color: #242424;
    border: 2px solid #333333;
    border-radius: 12px;
    padding: 12px 20px;
    color: #FFFFFF;
    font-size: 15px;
    selection-background-color: rgba(0, 168, 142, 0.3);
}

QLineEdit:focus {
    background-color: #2D2D2D;
    border-color: #00A88E;
    box-shadow: 0 0 0 4px rgba(0, 168, 142, 0.15);
}

QLineEdit:hover {
    border-color: #404040;
}

/* Адресная строка специально */
QLineEdit#addressBar {
    min-height: 44px;
    font-size: 16px;
    padding-left: 48px; /* Для иконки */
    padding-right: 48px; /* Для кнопки */
}

/* ==================== ВКЛАДКИ (MODERN TABS 2025) ==================== */
QTabWidget::pane {
    border: none;
    background-color: #0F0F0F;
}

QTabBar {
    background-color: transparent;
}

QTabBar::tab {
    background-color: transparent;
    color: #B4B4B4;
    border: none;
    border-radius: 10px 10px 0 0;
    padding: 12px 20px;
    margin-right: 4px;
    min-width: 120px;
    max-width: 240px;
    font-weight: 500;
}

QTabBar::tab:hover {
    background-color: rgba(255, 255, 255, 0.05);
    color: #FFFFFF;
}

QTabBar::tab:selected {
    background-color: #1A1A1A;
    color: #FFFFFF;
    border-bottom: 2px solid #00A88E;
}

QTabBar::close-button {
    image: url(:/icons/close.svg);
    subcontrol-position: right;
    margin: 4px;
}

QTabBar::close-button:hover {
    background-color: rgba(255, 71, 87, 0.2);
    border-radius: 4px;
}

/* ==================== СТАТУС БАР (MINIMALIST) ==================== */
QStatusBar {
    background-color: #1A1A1A;
    border-top: 1px solid #333333;
    padding: 6px 12px;
    color: #B4B4B4;
    font-size: 13px;
}

QStatusBar::item {
    border: none;
}

/* ==================== ПРОГРЕСС БАР (MODERN) ==================== */
QProgressBar {
    background-color: #242424;
    border: none;
    border-radius: 3px;
    height: 6px;
    text-align: center;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #00A88E, stop:1 #00C9A7);
    border-radius: 3px;
}

/* ==================== ДИАЛОГИ (GLASSMORPHISM) ==================== */
QDialog {
    background-color: #1A1A1A;
    border-radius: 16px;
    border: 1px solid #333333;
}

QDialogButtonBox {
    spacing: 12px;
    padding: 16px;
}

/* ==================== ГРУППЫ (CARD STYLE) ==================== */
QGroupBox {
    background-color: #1A1A1A;
    border: 1px solid #333333;
    border-radius: 12px;
    padding: 20px;
    margin-top: 12px;
    font-weight: 600;
    color: #FFFFFF;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    color: #FFFFFF;
    font-size: 15px;
}

/* ==================== СПИСКИ (MODERN LIST) ==================== */
QListWidget {
    background-color: #1A1A1A;
    border: 1px solid #333333;
    border-radius: 12px;
    padding: 8px;
    outline: none;
}

QListWidget::item {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 12px 16px;
    margin: 2px 0;
    color: #FFFFFF;
}

QListWidget::item:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

QListWidget::item:selected {
    background-color: rgba(0, 168, 142, 0.2);
    color: #00D4B3;
    border: 1px solid rgba(0, 168, 142, 0.4);
}

/* ==================== ТАБЛИЦЫ (DATA GRID) ==================== */
QTableWidget {
    background-color: #1A1A1A;
    border: 1px solid #333333;
    border-radius: 12px;
    gridline-color: #2D2D2D;
    outline: none;
}

QTableWidget::item {
    padding: 8px 12px;
    color: #FFFFFF;
}

QTableWidget::item:selected {
    background-color: rgba(0, 168, 142, 0.2);
    color: #00D4B3;
}

QHeaderView::section {
    background-color: #242424;
    color: #B4B4B4;
    padding: 12px;
    border: none;
    border-bottom: 1px solid #333333;
    font-weight: 600;
    font-size: 13px;
}

QHeaderView::section:hover {
    background-color: #2D2D2D;
}

/* ==================== ЧЕКБОКСЫ (MODERN TOGGLE) ==================== */
QCheckBox {
    spacing: 12px;
    color: #FFFFFF;
    font-size: 14px;
}

QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border-radius: 6px;
    border: 2px solid #404040;
    background-color: #242424;
}

QCheckBox::indicator:hover {
    border-color: #00A88E;
}

QCheckBox::indicator:checked {
    background-color: #00A88E;
    border-color: #00A88E;
    image: url(data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTIiIGhlaWdodD0iOSIgdmlld0JveD0iMCAwIDEyIDkiIGZpbGw9Im5vbmUiIHhtbG5zPSJodHRwOi8vd3d3LnczLm9yZy8yMDAwL3N2ZyI+CjxwYXRoIGQ9Ik0xIDQuNUw0LjUgOEwxMSAxIiBzdHJva2U9IndoaXRlIiBzdHJva2Utd2lkdGg9IjIiIHN0cm9rZS1saW5lY2FwPSJyb3VuZCIgc3Ryb2tlLWxpbmVqb2luPSJyb3VuZCIvPgo8L3N2Zz4K);
}

/* ==================== РАДИО КНОПКИ ==================== */
QRadioButton {
    spacing: 12px;
    color: #FFFFFF;
    font-size: 14px;
}

QRadioButton::indicator {
    width: 20px;
    height: 20px;
    border-radius: 10px;
    border: 2px solid #404040;
    background-color: #242424;
}

QRadioButton::indicator:hover {
    border-color: #00A88E;
}

QRadioButton::indicator:checked {
    background-color: #00A88E;
    border-color: #00A88E;
    image: url(data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTAiIGhlaWdodD0iMTAiIHZpZXdCb3g9IjAgMCAxMCAxMCIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj4KPGNpcmNsZSBjeD0iNSIgY3k9IjUiIHI9IjMiIGZpbGw9IndoaXRlIi8+Cjwvc3ZnPgo=);
}

/* ==================== КОМБОБОКС (DROPDOWN) ==================== */
QComboBox {
    background-color: #242424;
    border: 2px solid #333333;
    border-radius: 10px;
    padding: 10px 16px;
    min-height: 38px;
    color: #FFFFFF;
}

QComboBox:hover {
    border-color: #404040;
}

QComboBox:focus {
    border-color: #00A88E;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox::down-arrow {
    image: url(data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTIiIGhlaWdodD0iOCIgdmlld0JveD0iMCAwIDEyIDgiIGZpbGw9Im5vbmUiIHhtbG5zPSJodHRwOi8vd3d3LnczLm9yZy8yMDAwL3N2ZyI+CjxwYXRoIGQ9Ik0xIDFMNiA2TDExIDEiIHN0cm9rZT0id2hpdGUiIHN0cm9rZS13aWR0aD0iMiIgc3Ryb2tlLWxpbmVjYXA9InJvdW5kIiBzdHJva2UtbGluZWpvaW49InJvdW5kIi8+Cjwvc3ZnPgo=);
}

QComboBox QAbstractItemView {
    background-color: #1A1A1A;
    border: 1px solid #333333;
    border-radius: 10px;
    padding: 8px;
    selection-background-color: rgba(0, 168, 142, 0.2);
    outline: none;
}

/* ==================== СПИНБОКС ==================== */
QSpinBox {
    background-color: #242424;
    border: 2px solid #333333;
    border-radius: 10px;
    padding: 10px 16px;
    min-height: 38px;
    color: #FFFFFF;
}

QSpinBox:focus {
    border-color: #00A88E;
}

QSpinBox::up-button, QSpinBox::down-button {
    background-color: transparent;
    border: none;
    width: 20px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

/* ==================== СЛАЙДЕР (MODERN) ==================== */
QSlider::groove:horizontal {
    background: #2D2D2D;
    height: 6px;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #00C9A7, stop:1 #00A88E);
    width: 20px;
    height: 20px;
    margin: -7px 0;
    border-radius: 10px;
    border: 2px solid #FFFFFF;
}

QSlider::handle:horizontal:hover {
    background: #00D4B3;
    transform: scale(1.1);
}

QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #00A88E, stop:1 #00C9A7);
    border-radius: 3px;
}

/* ==================== СКРОЛЛБАР (MINIMAL) ==================== */
QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #404040;
    border-radius: 6px;
    min-height: 40px;
}

QScrollBar::handle:vertical:hover {
    background: #4D4D4D;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #404040;
    border-radius: 6px;
    min-width: 40px;
}

QScrollBar::handle:horizontal:hover {
    background: #4D4D4D;
}

/* ==================== ТУЛТИПЫ (FLOATING) ==================== */
QToolTip {
    background-color: #2D2D2D;
    color: #FFFFFF;
    border: 1px solid #404040;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
}

/* ==================== ЛЕЙБЛЫ ==================== */
QLabel {
    color: #FFFFFF;
    background: transparent;
}

QLabel[secondary="true"] {
    color: #B4B4B4;
}

QLabel[tertiary="true"] {
    color: #6B6B6B;
}

/* ==================== TIMEEDIT ==================== */
QTimeEdit {
    background-color: #242424;
    border: 2px solid #333333;
    border-radius: 10px;
    padding: 10px 16px;
    min-height: 38px;
    color: #FFFFFF;
}

QTimeEdit:focus {
    border-color: #00A88E;
}

/* ==================== АНИМАЦИИ И ЭФФЕКТЫ ==================== */
* {
    transition: all 0.2s cubic-bezier(0.4, 0.0, 0.2, 1);
}

QPushButton, QToolButton, QCheckBox::indicator, 
QRadioButton::indicator, QSlider::handle {
    transition: all 0.15s ease-out;
}
