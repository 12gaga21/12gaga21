/* 
 * Kaspersky Home Shield Browser
 * Modern Light Theme 2025
 * 
 * Дизайн: Минимализм + Чистота + Светлая тема
 */

/* ==================== ОСНОВНЫЕ ЦВЕТА ==================== */
* {
    /* Светлая палитра 2025 */
    --bg-primary: #FFFFFF;
    --bg-secondary: #F5F5F7;
    --bg-tertiary: #EBEBED;
    --bg-elevated: #FFFFFF;
    
    /* Акцентные цвета Kaspersky */
    --accent-primary: #00A88E;
    --accent-secondary: #00C9A7;
    --accent-hover: #00D4B3;
    
    /* Текст */
    --text-primary: #1D1D1F;
    --text-secondary: #6E6E73;
    --text-tertiary: #86868B;
    
    /* Границы */
    --border-color: #D2D2D7;
    --border-light: #E5E5EA;
    
    /* Состояния */
    --success: #00D98C;
    --warning: #FFB020;
    --danger: #FF4757;
    --info: #4E8FFF;
}

/* ==================== ГЛАВНОЕ ОКНО ==================== */
QMainWindow {
    background-color: #FFFFFF;
}

/* ==================== ЦЕНТРАЛЬНЫЙ ВИДЖЕТ ==================== */
QWidget {
    background-color: #FFFFFF;
    color: #1D1D1F;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Roboto", 
                 "Helvetica Neue", Arial, sans-serif;
    font-size: 14px;
}

/* ==================== МЕНЮ ==================== */
QMenuBar {
    background-color: #F5F5F7;
    border-bottom: 1px solid #D2D2D7;
    padding: 4px 8px;
    spacing: 8px;
}

QMenuBar::item {
    background: transparent;
    padding: 8px 16px;
    border-radius: 8px;
    color: #1D1D1F;
}

QMenuBar::item:selected {
    background-color: rgba(0, 168, 142, 0.1);
    color: #00A88E;
}

QMenu {
    background-color: #FFFFFF;
    border: 1px solid #D2D2D7;
    border-radius: 12px;
    padding: 8px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
}

QMenu::item {
    padding: 10px 24px 10px 16px;
    border-radius: 8px;
    margin: 2px 4px;
}

QMenu::item:selected {
    background-color: rgba(0, 168, 142, 0.1);
    color: #00A88E;
}

QMenu::separator {
    height: 1px;
    background: #E5E5EA;
    margin: 8px 12px;
}

/* ==================== ТУЛБАР ==================== */
QToolBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #F5F5F7, stop:1 #EBEBED);
    border: none;
    border-bottom: 1px solid #D2D2D7;
    spacing: 8px;
    padding: 8px 12px;
    min-height: 60px;
}

/* ==================== КНОПКИ ==================== */
QPushButton {
    background-color: #FFFFFF;
    color: #1D1D1F;
    border: 1px solid #D2D2D7;
    border-radius: 10px;
    padding: 10px 20px;
    font-weight: 500;
    font-size: 14px;
    min-height: 38px;
}

QPushButton:hover {
    background-color: #F5F5F7;
    border-color: #00A88E;
    box-shadow: 0 0 0 3px rgba(0, 168, 142, 0.1);
}

QPushButton:pressed {
    background-color: #EBEBED;
}

QPushButton:disabled {
    background-color: #F5F5F7;
    color: #86868B;
    border-color: #E5E5EA;
}

QPushButton[primary="true"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #00A88E, stop:1 #00C9A7);
    border: none;
    color: #FFFFFF;
    font-weight: 600;
}

QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 10px;
    padding: 10px;
    min-width: 40px;
    min-height: 40px;
    color: #1D1D1F;
}

QToolButton:hover {
    background-color: rgba(0, 0, 0, 0.05);
}

QToolButton:pressed {
    background-color: rgba(0, 0, 0, 0.1);
}

/* ==================== АДРЕСНАЯ СТРОКА ==================== */
QLineEdit {
    background-color: #F5F5F7;
    border: 2px solid #E5E5EA;
    border-radius: 12px;
    padding: 12px 20px;
    color: #1D1D1F;
    font-size: 15px;
    selection-background-color: rgba(0, 168, 142, 0.3);
}

QLineEdit:focus {
    background-color: #FFFFFF;
    border-color: #00A88E;
    box-shadow: 0 0 0 4px rgba(0, 168, 142, 0.1);
}

QLineEdit#addressBar {
    min-height: 44px;
    font-size: 16px;
    padding-left: 48px;
    padding-right: 48px;
}

/* ==================== ВКЛАДКИ ==================== */
QTabWidget::pane {
    border: none;
    background-color: #FFFFFF;
}

QTabBar::tab {
    background-color: transparent;
    color: #6E6E73;
    border: none;
    border-radius: 10px 10px 0 0;
    padding: 12px 20px;
    margin-right: 4px;
    font-weight: 500;
}

QTabBar::tab:hover {
    background-color: rgba(0, 0, 0, 0.05);
    color: #1D1D1F;
}

QTabBar::tab:selected {
    background-color: #F5F5F7;
    color: #1D1D1F;
    border-bottom: 2px solid #00A88E;
}

/* ==================== СТАТУС БАР ==================== */
QStatusBar {
    background-color: #F5F5F7;
    border-top: 1px solid #D2D2D7;
    padding: 6px 12px;
    color: #6E6E73;
    font-size: 13px;
}

/* ==================== ПРОГРЕСС БАР ==================== */
QProgressBar {
    background-color: #E5E5EA;
    border: none;
    border-radius: 3px;
    height: 6px;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #00A88E, stop:1 #00C9A7);
    border-radius: 3px;
}

/* ==================== ДИАЛОГИ ==================== */
QDialog {
    background-color: #FFFFFF;
    border-radius: 16px;
    border: 1px solid #D2D2D7;
}

/* ==================== ГРУППЫ ==================== */
QGroupBox {
    background-color: #F5F5F7;
    border: 1px solid #E5E5EA;
    border-radius: 12px;
    padding: 20px;
    margin-top: 12px;
    font-weight: 600;
    color: #1D1D1F;
}

/* ==================== СПИСКИ ==================== */
QListWidget {
    background-color: #F5F5F7;
    border: 1px solid #E5E5EA;
    border-radius: 12px;
    padding: 8px;
}

QListWidget::item {
    background-color: transparent;
    border-radius: 8px;
    padding: 12px 16px;
    margin: 2px 0;
    color: #1D1D1F;
}

QListWidget::item:hover {
    background-color: rgba(0, 0, 0, 0.05);
}

QListWidget::item:selected {
    background-color: rgba(0, 168, 142, 0.15);
    color: #00A88E;
}

/* ==================== ТАБЛИЦЫ ==================== */
QTableWidget {
    background-color: #F5F5F7;
    border: 1px solid #E5E5EA;
    border-radius: 12px;
    gridline-color: #EBEBED;
}

QTableWidget::item {
    padding: 8px 12px;
    color: #1D1D1F;
}

QTableWidget::item:selected {
    background-color: rgba(0, 168, 142, 0.15);
    color: #00A88E;
}

QHeaderView::section {
    background-color: #EBEBED;
    color: #6E6E73;
    padding: 12px;
    border: none;
    border-bottom: 1px solid #D2D2D7;
    font-weight: 600;
}

/* ==================== ЧЕКБОКСЫ ==================== */
QCheckBox {
    spacing: 12px;
    color: #1D1D1F;
}

QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border-radius: 6px;
    border: 2px solid #D2D2D7;
    background-color: #FFFFFF;
}

QCheckBox::indicator:hover {
    border-color: #00A88E;
}

QCheckBox::indicator:checked {
    background-color: #00A88E;
    border-color: #00A88E;
}

/* ==================== КОМБОБОКС ==================== */
QComboBox {
    background-color: #F5F5F7;
    border: 2px solid #E5E5EA;
    border-radius: 10px;
    padding: 10px 16px;
    min-height: 38px;
    color: #1D1D1F;
}

QComboBox:focus {
    border-color: #00A88E;
}

/* ==================== СЛАЙДЕР ==================== */
QSlider::groove:horizontal {
    background: #E5E5EA;
    height: 6px;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #00C9A7, stop:1 #00A88E);
    width: 20px;
    height: 20px;
    margin: -7px 0;
    border-radius: 10px;
    border: 2px solid #FFFFFF;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
}

QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #00A88E, stop:1 #00C9A7);
    border-radius: 3px;
}

/* ==================== СКРОЛЛБАР ==================== */
QScrollBar:vertical {
    background: transparent;
    width: 12px;
}

QScrollBar::handle:vertical {
    background: #D2D2D7;
    border-radius: 6px;
    min-height: 40px;
}

QScrollBar::handle:vertical:hover {
    background: #B4B4B4;
}

/* ==================== ТУЛТИПЫ ==================== */
QToolTip {
    background-color: #1D1D1F;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
}

/* ==================== ЛЕЙБЛЫ ==================== */
QLabel {
    color: #1D1D1F;
    background: transparent;
}

QLabel[secondary="true"] {
    color: #6E6E73;
}

QLabel[tertiary="true"] {
    color: #86868B;
}
